{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "Permissions-Policy", "value": "geolocation=(), camera=(), microphone=(), payment=(), usb=(), magnetometer=(), gyroscope=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://s3.tradingview.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://*.tradingview.com; frame-src https://*.tradingview.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/newscat.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    }
  ],
  "functions": {
    "api/market-digest.js": { "maxDuration": 60 },
    "api/journal.js":       { "maxDuration": 45 },
    "api/admin.js":         { "maxDuration": 60 },
    "api/correlations.js":  { "maxDuration": 30 },
    "api/real-yields.js":   { "maxDuration": 30 },
    "api/risk-regime.js":   { "maxDuration": 20 },
    "api/feeds.js":         { "maxDuration": 20 }
  },
  "crons": [
    {
      "path": "/api/admin?action=gdpnow",
      "schedule": "0 14 * * 1-5"
    }
  ]
}
