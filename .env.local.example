# Template env lokal — salin ke .env.local lalu isi nilai asli (JANGAN commit .env.local).
# Lihat ATURAN.md untuk konteks tiap provider/fitur.

# Telegram (alert health/setup TP-SL)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Upstash Redis — akun utama (state aplikasi, cache, gate AATAS, circuit breaker)
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_REDIS_REST_URL=

# Upstash Redis — akun kedua (rate limiter, terisolasi dari fitur kritikal)
UPSTASH2_REDIS_REST_TOKEN=
UPSTASH2_REDIS_REST_URL=

# Web Push VAPID keys
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=

# Auth internal (cron GitHub Actions/cron-job.org + gate APP_KEY publik)
CRON_SECRET=
APP_KEY=

# Provider AI
GEMINI_API_KEY=
MISTRAL_API_KEY=
NVIDIA_API_KEY=
DEEPSEEK_API_KEY=
SAMBANOVA_API_KEY1=
SAMBANOVA_API_KEY2=
OPEN_ROUTER_API=

# Data pasar
TWELVE_DATA_API_KEY=
DERIV_API_KEY=
DERIV_APP_ID=

# Riset (Scopus MCP)
SCOPUS_API_KEY=
SCOPUS1_API_KEY=
